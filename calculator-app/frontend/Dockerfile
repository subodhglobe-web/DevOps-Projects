# ---- Build stage ----
# Uses Yarn via Corepack instead of npm because npm was failing in this Docker
# environment with "Exit handler never called!" during dependency installation.
FROM node:20-bookworm-slim AS build

WORKDIR /app

COPY package.json ./

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

RUN yarn install --non-interactive --no-progress

COPY . .

RUN yarn build

# ---- Runtime stage ----
# Nginx serves the static files generated by Vite.
FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]